/* Timing model of the TCM blocks (itcm, dtcm) for OpenSTA.
 *
 * The TCMs are behavioral in rtl/tcm.sv and blackboxed in synthesis, so they add no
 * area. For timing they behave like synchronous SRAMs with these fixed numbers, the same
 * for every design:
 *   clock -> rdata          0.50 ns
 *   input setup to clock    0.20 ns   (en, wstrb/wmask, we, addr, wdata)
 *   input pin capacitance   0.005 pF
 */
library (tcm_macros) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_voltage : 1.8;
  nom_temperature : 25.0;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;

  type (b4)   { base_type : array; data_type : bit; bit_width : 4;   bit_from : 3;   bit_to : 0; downto : true; }
  type (b16)  { base_type : array; data_type : bit; bit_width : 16;  bit_from : 15;  bit_to : 0; downto : true; }
  type (b18)  { base_type : array; data_type : bit; bit_width : 18;  bit_from : 17;  bit_to : 0; downto : true; }
  type (b32)  { base_type : array; data_type : bit; bit_width : 32;  bit_from : 31;  bit_to : 0; downto : true; }
  type (b128) { base_type : array; data_type : bit; bit_width : 128; bit_from : 127; bit_to : 0; downto : true; }

  /* ---------------- itcm: 32-bit single port ---------------- */
  cell (itcm) {
    area : 0;
    dont_use : true;
    dont_touch : true;
    pin (clk) { direction : input; clock : true; capacitance : 0.005; }
    pin (en) {
      direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (wstrb) {
      bus_type : b4; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (addr) {
      bus_type : b16; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (wdata) {
      bus_type : b32; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (rdata) {
      bus_type : b32; direction : output;
      timing () { related_pin : "clk"; timing_type : rising_edge;
        cell_rise (scalar) { values ("0.50"); } cell_fall (scalar) { values ("0.50"); }
        rise_transition (scalar) { values ("0.10"); } fall_transition (scalar) { values ("0.10"); } }
    }
  }

  /* ---------------- dtcm: port A 32-bit, port B 128-bit ---------------- */
  cell (dtcm) {
    area : 0;
    dont_use : true;
    dont_touch : true;
    pin (clk) { direction : input; clock : true; capacitance : 0.005; }
    pin (a_en) {
      direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (a_wstrb) {
      bus_type : b4; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (a_addr) {
      bus_type : b18; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (a_wdata) {
      bus_type : b32; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (a_rdata) {
      bus_type : b32; direction : output;
      timing () { related_pin : "clk"; timing_type : rising_edge;
        cell_rise (scalar) { values ("0.50"); } cell_fall (scalar) { values ("0.50"); }
        rise_transition (scalar) { values ("0.10"); } fall_transition (scalar) { values ("0.10"); } }
    }
    pin (b_en) {
      direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    pin (b_we) {
      direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (b_wmask) {
      bus_type : b16; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (b_addr) {
      bus_type : b18; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (b_wdata) {
      bus_type : b128; direction : input; capacitance : 0.005;
      timing () { related_pin : "clk"; timing_type : setup_rising;
        rise_constraint (scalar) { values ("0.20"); } fall_constraint (scalar) { values ("0.20"); } }
    }
    bus (b_rdata) {
      bus_type : b128; direction : output;
      timing () { related_pin : "clk"; timing_type : rising_edge;
        cell_rise (scalar) { values ("0.50"); } cell_fall (scalar) { values ("0.50"); }
        rise_transition (scalar) { values ("0.10"); } fall_transition (scalar) { values ("0.10"); } }
    }
  }
}
